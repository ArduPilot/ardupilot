#!/usr/bin/env bash

_waf()
{
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    # don't complet =
    _init_completion -n = || return

    # everything below runs ./waf, so the caches belong to one checkout
    if [ "$_waf_comp_dir" != "$PWD" ]; then
      _waf_comp_dir=$PWD
      unset _waf_comp_opts _waf_comp_bulk _waf_comp_targets _waf_comp_boards
    fi

    # Everything waf advertises, scraped from its own help and cached for the
    # shell session: ./waf --help costs ~0.2s and this runs on every tab press.
    # Always './waf', so waf and ./waf propose the same thing.
    if [ -z "$_waf_comp_opts" ]; then
      local help parsed
      # no help means no checkout here; leave the cache empty rather than fill
      # it with the few hardcoded words below and never look again
      help=$(./waf --help 2>/dev/null) && [ -n "$help" ] || return 0
      # keep plain option words only: the help text quotes examples such as
      # "`waf copter --upload`", from which _parse_help reports an --upload
      # with the backtick still attached
      parsed=$(_parse_help - <<< "$help" | grep -E '^[-A-Za-z0-9_=.]+$')
      # the generated --enable-FOO/--disable-FOO and the --embed-* applets are
      # some 900 of waf's ~1000 options and bury everything else; hold them back
      # until the word being completed asks for one.  --disable-Werror is hand
      # written rather than generated, so it stays in the short list.
      local bulk='^--(enable|disable)-[A-Z]|^--embed-'
      local handwritten='^--disable-Werror$'
      _waf_comp_bulk=$(grep -E "$bulk" <<< "$parsed" | grep -vE "$handwritten" | tr '\n' ' ')
      _waf_comp_opts=$(grep -vE "$bulk" <<< "$parsed" | tr '\n' ' ')
      _waf_comp_opts+=" $(grep -E "$handwritten" <<< "$parsed" | tr '\n' ' ')"
      # short options, which _parse_help does not report
      _waf_comp_opts+=" -h -j -v -g"
      # commands, from the help's own list plus the ones it omits
      _waf_comp_opts+=" $(sed -n '/^Main commands/,/^Options:/p' <<< "$help" \
          | sed -n 's/^  \([a-zA-Z_][a-zA-Z0-9_-]*\) *: .*/\1/p' | sed '/^conf$/d' | tr '\n' ' ')"
      _waf_comp_opts+=" submodule_force_clean submodulesync scripting_docs"
    fi

    opts=$_waf_comp_opts
    case $cur in
      --enable-*|--disable-*|--embed-*)
        opts+=" $_waf_comp_bulk"
        ;;
    esac

    # Prevent word reuse.  Compared word by word: a substring test would let
    # an already typed --debug strip the --debug-symbols out of the proposals.
    local used=" ${COMP_WORDS[*]:0:COMP_CWORD} "
    local opt kept=""
    for opt in $opts; do
        [[ $used == *" $opt "* ]] || kept+=" $opt"
    done
    opts=$kept

    # --board <TAB> and --board=<TAB>, cached like the options: list_boards
    # costs about as much as --help
    if [ "$prev" = "--board" ] || [[ $cur == --board=* ]]; then
      [[ $cur == --board=* ]] && cur=${cur#*=}
      if [ -z "$_waf_comp_boards" ]; then
        _waf_comp_boards=$(./waf list_boards 2>/dev/null | sed -e '$d' | tr '\n' ' ')
      fi
      mapfile -t COMPREPLY < <(compgen -W "${_waf_comp_boards}" -- "${cur}")
      return 0
    fi

    case $cur in
      --targets=*)
        cur=${cur#*=}
        if [ -z "$_waf_comp_targets" ]; then
          # list target without color, remove Lua embedding, remove empty and space only line, remove objs/*, remove path for lua binding, remove trailing spaces, change line return for space
          _waf_comp_targets=$(./waf list -c no 2>/dev/null | sed -e '/^Embedding/d' -e '/^ *$/d' -e '/objs\//d' -e '$d' -e '/^\//d' | tr -d " " | tr '\n' ' ')
        fi
        opts=$_waf_comp_targets
        mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
        return 0
        ;;
    esac

    mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
    [[ ${COMPREPLY-} == *= ]] && compopt -o nospace
}


complete -F _waf waf
