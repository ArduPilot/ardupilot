# Retained mission / attitude limits / geometry
RTL_ALTITUDE     200
FBWB_CLIMB_RATE  5
PTCH_LIM_MAX_DEG 20
PTCH_LIM_MIN_DEG -25
ROLL_LIMIT_DEG   70
SCALING_SPEED    40
WP_LOITER_RAD    180
WP_RADIUS        140
AIRSPEED_MAX     80
AIRSPEED_CRUISE  40

# Airspeed envelope & cruise trim (elevator saturates ~25-26 m/s)
AIRSPEED_MIN     28
AIRSPEED_STALL   25
TRIM_THROTTLE    13

# Roll & Pitch tuning (from SITL AUTOTUNE_LEVEL=7; overrides models/plane.parm TCONST)
RLL2SRV_TCONST   0.30
RLL2SRV_RMAX     90
RLL_RATE_FF      0.088015
RLL_RATE_P       0.192931
RLL_RATE_I       0.088015
RLL_RATE_D       0.010484
RLL_RATE_IMAX    0.666667
RLL_RATE_FLTT    5.305164
RLL_RATE_FLTD    10.0

PTCH2SRV_TCONST  0.45
PTCH2SRV_RMAX_UP 90
PTCH2SRV_RMAX_DN 90
PTCH2SRV_RLL     1.04
PTCH_RATE_FF     1.387508
PTCH_RATE_P      0.142701
PTCH_RATE_I      1.387508
PTCH_RATE_D      0.007158
PTCH_RATE_IMAX   0.85
PTCH_RATE_FLTT   3.536776
PTCH_RATE_FLTD   10.0

# Yaw damper & turn coordination
YAW2SRV_DAMP     0.40
YAW2SRV_INT      0.50
YAW2SRV_SLIP     0.50

# TECS & L1 navigation
TECS_SINK_MIN    8.0
TECS_SINK_MAX    16.0
TECS_CLMB_MAX    14.0
TECS_PITCH_MAX   20
TECS_PITCH_MIN   -15
TECS_RLL2THR     8.6
TECS_TIME_CONST  4.0
TECS_THR_DAMP    0.6
TECS_PTCH_DAMP   0.4
TECS_INTEG_GAIN  0.2
THR_SLEWRATE     80
NAVL1_PERIOD     18

# Takeoff (keep full throttle on runway vs SITL friction, allow TECS range after liftoff)
TKOFF_ROTATE_SPD 26
TKOFF_THR_MAX    100
TKOFF_THR_MIN    25
TKOFF_OPTIONS    1

# Autoland & flare (explicit override of models/plane.parm LAND_PITCH_DEG=1)
TECS_LAND_ARSPD  32
TECS_LAND_SPDWGT 0.0
TECS_LAND_PMAX   0
TECS_LAND_IGAIN  0.4
TECS_LAND_DAMP   0.8
TECS_LAND_SINK   0.5
TECS_FLARE_HGT   1.8
LAND_FLARE_SEC   2.0
LAND_FLARE_ALT   5.5
LAND_PITCH_DEG   5.0
