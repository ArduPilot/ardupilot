:name: ArduPilot F405
:description: boots an ArduPilot STM32F405 firmware ELF

# Common to every F405 board. Include a generated per-board .resc,
# which sets $platform/$elf and then comes here (or set them by hand
# for bring-up).

$repo?=@.
$elf?=@none
$platform?=@Tools/renode/platforms/stm32f405_base.repl

# each .cs is compiled on its own against the ones included before it
include $repo/Tools/renode/peripherals/stm32/AP_STM32_IWDG.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32F4_FlashController.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32F4_RCC.cs
include $repo/Tools/renode/peripherals/common/AP_NVIC_RettobaseFix.cs
include $repo/Tools/renode/peripherals/common/AP_DWT.cs
include $repo/Tools/renode/peripherals/common/AP_PersistentMemory.cs
include $repo/Tools/renode/peripherals/common/AP_Hotplug.cs
include $repo/Tools/renode/peripherals/common/AP_Physics.cs
include $repo/Tools/renode/peripherals/common/AP_I2CRegisterDevice.cs
include $repo/Tools/renode/peripherals/common/AP_UARTFrameDevice.cs
include $repo/Tools/renode/peripherals/common/AP_UARTPacer.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32_Timer_Actuators.cs
include $repo/Tools/renode/peripherals/common/AP_IOMCU.cs
include $repo/Tools/renode/peripherals/common/AP_SPIMultiplexer.cs
include $repo/Tools/renode/peripherals/common/AP_CANMcast.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32F4_I2C.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32_ADC.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32_OTG.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32F1_UART.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32DMA_Fixup.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32DMA_Circular.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32F_SDMMC_DmaPump.cs
include $repo/Tools/renode/peripherals/stm32/AP_UartRxDmaPump.cs
include $repo/Tools/renode/peripherals/stm32/AP_STM32_Timer_UpdateDMA.cs
include $repo/Tools/renode/peripherals/sensors/AP_ADIS.cs
include $repo/Tools/renode/peripherals/sensors/AP_AdditionalBarometers.cs
include $repo/Tools/renode/peripherals/sensors/AP_PowerMonitors.cs
include $repo/Tools/renode/peripherals/sensors/AP_I2COutputs.cs
include $repo/Tools/renode/peripherals/sensors/AP_OpticalFlow.cs
include $repo/Tools/renode/peripherals/sensors/AP_IRLock.cs
include $repo/Tools/renode/peripherals/sensors/AP_Displays.cs
include $repo/Tools/renode/peripherals/sensors/AP_BMP280.cs
include $repo/Tools/renode/peripherals/sensors/AP_BMP388.cs
include $repo/Tools/renode/peripherals/sensors/AP_DPS310.cs
include $repo/Tools/renode/peripherals/sensors/AP_ICM20689.cs
include $repo/Tools/renode/peripherals/sensors/AP_ICM42688.cs
include $repo/Tools/renode/peripherals/sensors/AP_InvensenseV2.cs
include $repo/Tools/renode/peripherals/sensors/AP_MS5611.cs
include $repo/Tools/renode/peripherals/sensors/AP_RegisterIMU.cs
include $repo/Tools/renode/peripherals/sensors/AP_UBlox.cs
include $repo/Tools/renode/peripherals/sensors/AP_Airspeed.cs
include $repo/Tools/renode/peripherals/sensors/AP_I2CRangefinders.cs
include $repo/Tools/renode/peripherals/sensors/AP_IST8310.cs
include $repo/Tools/renode/peripherals/sensors/AP_AdditionalCompasses.cs
include $repo/Tools/renode/peripherals/sensors/AP_TemperatureSensors.cs
include $repo/Tools/renode/peripherals/sensors/AP_Benewake.cs
include $repo/Tools/renode/peripherals/sensors/AP_LightWare.cs
include $repo/Tools/renode/peripherals/sensors/AP_SerialRangefinders.cs
include $repo/Tools/renode/peripherals/sensors/AP_SerialNMEASensors.cs
include $repo/Tools/renode/peripherals/sensors/AP_SerialOpticalFlow.cs
include $repo/Tools/renode/peripherals/sensors/AP_AIS.cs
include $repo/Tools/renode/peripherals/sensors/AP_PozyxBeacon.cs
include $repo/Tools/renode/peripherals/sensors/AP_MarvelmindBeacon.cs
include $repo/Tools/renode/peripherals/sensors/AP_NooploopBeacon.cs
include $repo/Tools/renode/peripherals/sensors/AP_NMEAOutput.cs
include $repo/Tools/renode/peripherals/sensors/AP_LTMOutput.cs
include $repo/Tools/renode/peripherals/sensors/AP_DevoOutput.cs
include $repo/Tools/renode/peripherals/sensors/AP_FrSkyDOutput.cs
include $repo/Tools/renode/peripherals/storage/AP_RAMTRON.cs

mach create "ardupilot"
machine LoadPlatformDescription $platform

# register names in access logs; run.py supplies the verified cached file
sysbus ApplySVD $mcu_svd

sysbus LoadELF $elf

# The generated board script gets the application base from the application
# and bootloader hwdefs. run.py selects the bootloader vector table when one
# is loaded, otherwise execution starts directly in the application.
$app_base?=0x08010000
$vector_base?=$app_base
cpu VectorTableOffset $vector_base

# ... and again after every reset: ArduPilot reboots itself via
# NVIC_SystemReset (MAV_CMD_PREFLIGHT_REBOOT, watchdog paths), and
# Renode restores the default vector table at 0 on reset, where
# nothing is mapped - the CPU would silently halt while the emulation
# looks healthy.
macro reset
"""
    cpu VectorTableOffset $vector_base
"""

# NOT one instruction per 168MHz cycle: 5-wait-state flash and AHB
# contention derate the real part, and the AM32 harness showed the
# number is load-bearing (a too-fast core can turn one-cycle-late
# peripheral interactions into stable wrong states). Start at 125,
# tune against a real board's scheduler load figures.
cpu PerformanceInMips 125

emulation SetGlobalQuantum "0.001"
# Pace virtual time against host time when the emulator is fast enough. This
# only sleeps when virtual time is ahead; slow emulation remains unrestricted.
emulation SetGlobalAdvanceImmediately false
