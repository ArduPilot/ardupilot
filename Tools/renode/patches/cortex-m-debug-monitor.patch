+/* Guest DebugMonitor events are independent of the host debugger. */
+void HELPER(debug_monitor_check)(uint32_t address)
+{
+#ifdef TARGET_PROTO_ARM_M
+    int exception = 0;
+    if(env->v7m.fpb_control & 1) {
+        for(unsigned i = 0; i < 8; i++) {
+            uint32_t comp = env->v7m.fpb_comparator[i];
+            if((comp & 1) && (comp & ~1u) == address) {
+                exception = EXCP_FPB;
+                break;
+            }
+        }
+    }
+    if(!exception && (env->v7m.debug_monitor_control & (1u << 18)) && !env->v7m.exception) {
+        if(env->v7m.monitor_step_seen) {
+            exception = EXCP_MON_STEP;
+        } else {
+            env->v7m.monitor_step_seen = 1;
+        }
+    }
+    if(exception) {
+        env->regs[15] = address;
+        env->exception_index = exception;
+        cpu_loop_exit_without_hook(env);
+    }
+#endif
+}
