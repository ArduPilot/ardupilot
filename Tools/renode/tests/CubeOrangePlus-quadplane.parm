# Renode supplies flight state and attached sensors rather than physical RC,
# safety-switch, power-monitor and peripheral wiring.
ARMING_CHECK 0
AHRS_EKF_TYPE 3
BATT_MONITOR 0
BRD_SAFETY_DEFLT 0
RC_PROTOCOLS 0
THR_FAILSAFE 0
GPS1_TYPE 1
SERIAL2_PROTOCOL 5
ARSPD_TYPE 1
ARSPD_USE 1
SR1_EXT_STAT 2
SR1_POSITION 2
SR1_EXTRA1 2
SR1_EXTRA2 2
AUTO_OPTIONS 3

# Standard SITL QuadPlane airframe and tune.
Q_ENABLE 1
Q_FRAME_CLASS 1
Q_FRAME_TYPE 1
Q_ASSIST_SPEED 18
Q_M_THST_EXPO 0.65
Q_M_PWM_MIN 1000
Q_M_PWM_MAX 2000
Q_M_BAT_VOLT_MAX 12.8
Q_M_BAT_VOLT_MIN 9.6
Q_A_RAT_RLL_P 0.108
Q_A_RAT_RLL_I 0.108
Q_A_RAT_RLL_D 0.001
Q_A_RAT_PIT_P 0.103
Q_A_RAT_PIT_I 0.103
Q_A_RAT_PIT_D 0.001
Q_A_RAT_YAW_P 0.2
Q_A_RAT_YAW_I 0.02
Q_A_ANG_RLL_P 6
Q_A_ANG_PIT_P 6
AIRSPEED_MIN 13
AIRSPEED_MAX 35
AIRSPEED_CRUISE 20
ROLL_LIMIT_DEG 55
PTCH_LIM_MAX_DEG 30
PTCH_LIM_MIN_DEG -30
NAVL1_PERIOD 14
SCHED_LOOP_RATE 300

# Calibrated simulated sensors.
INS_ACCOFFS_X 0.001
INS_ACCOFFS_Y 0.001
INS_ACCOFFS_Z 0.001
INS_ACCSCAL_X 1.001
INS_ACCSCAL_Y 1.001
INS_ACCSCAL_Z 1.001
INS_ACC2OFFS_X 0.001
INS_ACC2OFFS_Y 0.001
INS_ACC2OFFS_Z 0.001
INS_ACC2SCAL_X 1.001
INS_ACC2SCAL_Y 1.001
INS_ACC2SCAL_Z 1.001
INS_GYR_CAL 0
COMPASS_OFS_X -0.453570
COMPASS_OFS_Y -0.585846
COMPASS_OFS_Z 6.815743
LAND_DISARMDELAY 1
