# Minimal Renode defaults for Benewake serial rangefinder production-driver probes.
ARMING_CHECK 0
BATT_MONITOR 0
BRD_SAFETY_DEFLT 0
GPS1_TYPE 0
RC_PROTOCOLS 0
SERIAL3_PROTOCOL 9
SERIAL3_BAUD 115
SERIAL4_PROTOCOL 9
SERIAL4_BAUD 115
SERIAL5_PROTOCOL 9
SERIAL5_BAUD 115
RNGFND1_TYPE 19
RNGFND2_TYPE 20
RNGFND3_TYPE 27
