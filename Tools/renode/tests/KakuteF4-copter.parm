# Renode supplies the flight state and attached sensors rather than physical
# RC, safety-switch, power-monitor and peripheral wiring.
ARMING_CHECK 0
AHRS_EKF_TYPE 3
BATT_MONITOR 0
BRD_SAFETY_DEFLT 0
FS_THR_ENABLE 0
RC_PROTOCOLS 0
GPS1_TYPE 1
SERIAL3_PROTOCOL 5
# Keep telemetry below the small F4 UART's buffer capacity.
SR1_EXT_STAT 2
SR1_POSITION 2
SR1_EXTRA1 2
SR1_EXTRA2 2
AUTO_OPTIONS 3
# Match the KakuteF4 Betaflight motor order to the bfx physics model.
FRAME_CLASS 1
FRAME_TYPE 12
# Match the controller timing to the sustainable F405 Renode cadence.
SCHED_LOOP_RATE 125
# Keep the compact mission inside conservative acceleration and speed limits.
WP_SPD 1
WP_ACC 0.5
WP_YAW_BEHAVIOR 0
# Standard SITL multicopter tune and calibrated accelerometer values.
ATC_ANG_RLL_P 2
ATC_ANG_PIT_P 2
ATC_RAT_RLL_P 0.05
ATC_RAT_RLL_I 0.05
ATC_RAT_RLL_D 0.001
ATC_RAT_PIT_P 0.05
ATC_RAT_PIT_I 0.05
ATC_RAT_PIT_D 0.001
ATC_RAT_YAW_P 0.3
ATC_RAT_YAW_I 0.02
MOT_THST_EXPO 0.65
MOT_THST_HOVER 0.39
MOT_BAT_VOLT_MIN 9.6
MOT_BAT_VOLT_MAX 12.8
INS_ACCOFFS_X 0.001
INS_ACCOFFS_Y 0.001
INS_ACCOFFS_Z 0.001
INS_ACCSCAL_X 1.001
INS_ACCSCAL_Y 1.001
INS_ACCSCAL_Z 1.001
INS_GYR_CAL 0
COMPASS_OFS_X 5
COMPASS_OFS_Y 13
COMPASS_OFS_Z -18
LAND_DISARMDELAY 1
