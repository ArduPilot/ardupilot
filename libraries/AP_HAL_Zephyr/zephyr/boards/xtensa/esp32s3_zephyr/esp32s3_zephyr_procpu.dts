 *
 * ESP32-S3 generic dev board (ESP32-S3-DevKitC compatible)
 * USB CDC ACM via built-in USB OTG peripheral.
 */
/dts-v1/;

#include <espressif/esp32s3/esp32s3_wroom_n8.dtsi>
#include <espressif/partitions_0x0_amp.dtsi>
#include "esp32s3_zephyr-pinctrl.dtsi"

/ {
	model = "ESP32-S3 AP_HAL_Zephyr";
	compatible = "espressif,esp32s3";

	chosen {
		zephyr,sram = &sram1;
		/* Console moved cdc_acm0 -> uart0 (2026-08-14): on the CDC it interleaved printk
		 * with MAVLink and died permanently when the TX fifo overflowed. */
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		uart-0 = &uart0;
		led0 = &led_builtin;
	};

	leds {
		compatible = "gpio-keys";
		led_builtin: led_builtin {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "LED";
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* USB OTG — device mode, CDC ACM console.
 * GPIO19 (D-) / GPIO20 (D+) are connected to the DevKitC USB-C connector
 * and are shared by both usb_serial and usb_otg — only one may be active. */
zephyr_udc0: &usb_otg {
	status = "okay";

	cdc_acm0: cdc_acm0 {
		compatible = "zephyr,cdc-acm-uart";
		/* Console + SERIAL0 share this CDC. The default 1024-byte TX fifo drops
		 * everything past the first KB of boot output when the host attaches late. */
		tx-fifo-size = <16384>;
	};
};

&usb_serial {
	status = "disabled";
};

/* SoC WiFi MAC - required by CONFIG_WIFI_ESP32 (DT_HAS_ESPRESSIF_ESP32_WIFI);
 * the softAP MAVLink serial ports ride on it (WiFiDriver.cpp). */
&wifi {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};
