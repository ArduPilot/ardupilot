# Core kernel
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_PINCTRL=y
CONFIG_CLOCK_CONTROL=y
CONFIG_CORTEX_M_SYSTICK=y

# Serial / UART
CONFIG_SERIAL=y
CONFIG_UART_MCUX_LPUART=y

# SPI
CONFIG_SPI=y
# CONFIG_SPI_NXP_LPSPI=y  # minimal bring-up: no enabled DT instances

# I2C
CONFIG_I2C=y
CONFIG_I2C_MCUX_LPI2C=y

# GPIO
CONFIG_GPIO=y
CONFIG_GPIO_MCUX_IGPIO=y

# ADC (LPADC)
CONFIG_ADC=y
# CONFIG_ADC_MCUX_LPADC=y  # minimal bring-up: no enabled DT instances

# PWM (eFlexPWM)
CONFIG_PWM=y


# CAN (FlexCAN) — DroneCAN / UAVCAN
CONFIG_CAN=y
# CONFIG_CAN_MCUX_FLEXCAN=y  # minimal bring-up: no enabled DT instances

# Disable features not needed in ArduPilot build
CONFIG_CONSOLE=n
CONFIG_PRINTK=n
CONFIG_LOG=n
CONFIG_SHELL=n
