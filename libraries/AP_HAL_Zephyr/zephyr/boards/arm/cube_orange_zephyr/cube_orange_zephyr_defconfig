# Serial / UART
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# SPI
CONFIG_SPI=y

# I2C
CONFIG_I2C=y

# GPIO
CONFIG_GPIO=y

# ADC
CONFIG_ADC=y

# CAN (FDCAN via STM32H7 FDCAN controller)
CONFIG_CAN=y
CONFIG_CAN_STM32H7_FDCAN=y

# USB CDC ACM (device_next class backend)
CONFIG_USBD_CDC_ACM_CLASS=y

# Suppress console output; ArduPilot drives its own UARTs
CONFIG_CONSOLE=n
CONFIG_PRINTK=n
CONFIG_LOG=n
CONFIG_SHELL=n
