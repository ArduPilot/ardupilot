# Parameters for models/quadruped.gltf, applied on top of Rover's. Written
# by tools/make_hexapod.py: change the legs there, not here.
# models/quadruped.lua turns Rover's steering and throttle into the leg servos.
SCR_ENABLE      1
SCR_HEAP_SIZE   200000

# the legs: 12 servos, 4 legs of 3
SERVO1_FUNCTION 94
SERVO2_FUNCTION 95
SERVO3_FUNCTION 96
SERVO4_FUNCTION 97
SERVO5_FUNCTION 98
SERVO6_FUNCTION 99
SERVO7_FUNCTION 100
SERVO8_FUNCTION 101
SERVO9_FUNCTION 102
SERVO10_FUNCTION 103
SERVO11_FUNCTION 104
SERVO12_FUNCTION 105

# Steering and throttle outputs, which Rover will not arm without.
# Nothing is plugged into them: the gait reads what ArduPilot would
# have sent.
SERVO13_FUNCTION 26
SERVO14_FUNCTION 70

# it walks at a few tenths of a metre a second, not at a car's pace
CRUISE_SPEED    0.25
CRUISE_THROTTLE 60
WP_SPEED        0.25
WP_RADIUS       0.5

SIM_RATE_HZ     400
