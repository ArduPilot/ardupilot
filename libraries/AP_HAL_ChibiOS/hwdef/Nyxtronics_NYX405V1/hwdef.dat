# hw definition file for processing by chibios_hwdef.py
# for Nyxtronics NYX405V1 hardware.

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID for firmware load
APJ_BOARD_ID AP_HW_NYXTRONICS_NYX405V1

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# bootloader takes first section of flash
FLASH_RESERVE_START_KB 48

define HAL_STORAGE_SIZE 15360
STORAGE_FLASH_PAGE 1

STM32_ST_USE_TIMER 5

# SPI devices

# SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# SPI2
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

# SPI3
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PC12 SPI3_MOSI SPI3

# Chip select pins
PB12 FLASH1_CS CS
PA4 GYRO1_CS CS
PB3 OSD1_CS CS

# Beeper
PC13 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80

# SERIAL ports
SERIAL_ORDER OTG1 USART1 EMPTY USART3 UART4 UART5 USART6
# PA10 IO-debug-console
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1
PA10 USART1_RX USART1
PA9 USART1_TX USART1
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_None

# USART3
# NODMA: the only RX stream (DMA1 stream 1) is used by TIM2 (M3/M4 DShot),
# and the TX streams are used by SPI2 (dataflash)
PB10 USART3_TX USART3 NODMA
PB11 USART3_RX USART3 NODMA
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_MSP_DisplayPort

# UART4
# NODMA: the only RX stream (DMA1 stream 2) is used by TIM3 (M1/M2 DShot),
# and the only TX stream is used by SPI2 (dataflash)
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA

# UART5 (RX only, TX pin PC12 used by SPI3)
# NODMA: the only RX stream (DMA1 stream 0) is used by SPI3 (OSD)
PD2 UART5_RX UART5 NODMA
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_ESCTelemetry

# USART6
PC6 USART6_TX USART6
PC7 USART6_RX USART6
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_RCIN


# I2C ports
I2C_ORDER I2C1
# I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

BARO DPS310 I2C:0:0x76

# ADC ports

# ADC1
PC3 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 13
define HAL_BATT_CURR_SCALE 125.0
PC4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 14
define HAL_BATT_VOLT_SCALE 11.0
PC5 RSSI_ADC ADC1
define BOARD_RSSI_ANA_PIN 15
define HAL_BATT_MONITOR_DEFAULT 4

# MOTORS
PB1 TIM3_CH4 TIM3 PWM(1) GPIO(50) BIDIR # M1
PB0 TIM3_CH3 TIM3 PWM(2) GPIO(51)       # M2
PA3 TIM2_CH4 TIM2 PWM(3) GPIO(52)       # M3
PA2 TIM2_CH3 TIM2 PWM(4) GPIO(53) BIDIR # M4

# Servo
PB9 TIM4_CH4 TIM4 PWM(5) GPIO(54)       # S1

# LEDs
PA8 LED0 OUTPUT LOW GPIO(90)
define HAL_GPIO_A_LED_PIN 90
PC8 TIM8_CH3 TIM8 PWM(6) GPIO(58)       # LED strip
define DEFAULT_NTF_LED_TYPES 257

# PINIO1 controls the 12V BEC..
# HIGH = BEC enabled; Driven HIGH at boot so it is on by default.
PB4 PINIO1 OUTPUT GPIO(81) HIGH
PA15 PINIO2 OUTPUT GPIO(82) LOW
define RELAY1_PIN_DEFAULT 81
define RELAY1_DEFAULT 1
define RELAY2_PIN_DEFAULT 82

# Dataflash setup
SPIDEV dataflash SPI2 DEVID1 FLASH1_CS     MODE3 32*MHZ 32*MHZ

define HAL_LOGGING_DATAFLASH_ENABLED 1

# OSD setup
SPIDEV osd SPI3 DEVID1 OSD1_CS   MODE0  10*MHZ  10*MHZ

define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

# IMU setup
SPIDEV imu1   SPI1 DEVID1 GYRO1_CS   MODE3   2*MHZ   16*MHZ
SPIDEV bmi270 SPI1 DEVID1 GYRO1_CS   MODE3   1*MHZ   10*MHZ

IMU Invensensev3 SPI:imu1 ROTATION_ROLL_180_YAW_90
IMU BMI270 SPI:bmi270 ROTATION_ROLL_180
DMA_NOSHARE TIM2_UP TIM3_UP SPI1*
DMA_PRIORITY I2C* SPI1* TIM2_UP TIM3_UP

# No built-in compass, but probe the i2c bus for all possible
# external compass types
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_DEFAULT_INS_FAST_SAMPLE 1
# Motor order implies "X" frame for standard ESCs
define HAL_FRAME_TYPE_DEFAULT 12


include ../include/minimize_fpv_osd.inc
