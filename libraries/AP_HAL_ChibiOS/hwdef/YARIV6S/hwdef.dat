# hw definition file for processing by chibios_hwdef.py
# for the YARIV6S hardware

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# crystal frequency
OSCILLATOR_HZ 16000000

# ChibiOS system timer
STM32_ST_USE_TIMER 2

# board ID for firmware load
APJ_BOARD_ID AP_HW_YARIV6S

# Enable IMUs to be used
define HAL_EKF_IMU_MASK_DEFAULT 1

FLASH_RESERVE_START_KB 128

# to be compatible with the px4 bootloader we need
# to use a different RAM_MAP
env USE_ALT_RAM_MAP 1

# flash size
FLASH_SIZE_KB 2048

# order of UARTs (and USB) no IO MCU
SERIAL_ORDER OTG1 UART7 UART5 USART1 UART8 USART2 UART4 USART3 USART6 OTG2

# default to all pins low to avoid ESD issues
DEFAULTGPIO OUTPUT LOW PULLDOWN

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# telem1
PE8 UART7_TX UART7
PF6 UART7_RX UART7
PF8 UART7_RTS UART7
PE10 UART7_CTS UART7

# telem2
PC8 UART5_RTS UART5
PC9 UART5_CTS UART5
PC12 UART5_TX UART5
PD2 UART5_RX UART5

# telem3
PA3 USART2_RX USART2
PD5 USART2_TX USART2
PD3 USART2_CTS USART2
PD4 USART2_RTS USART2

# GPS1
PB6 USART1_TX USART1
PB7 USART1_RX USART1

# GPS2
PE0 UART8_RX UART8
PE1 UART8_TX UART8

# uart4
PH13 UART4_TX UART4
PH14 UART4_RX UART4

# debug uart
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# USART6 is for RC
PC6 USART6_TX USART6
PC7 USART6_RX USART6
define DEFAULT_SERIAL8_PROTOCOL SerialProtocol_RCIN

# ADC
PA0 SCALED1_V3V3 ADC1 SCALE(2)
PB1 VDD_5V_SENS  ADC1 SCALE(2)
# pin3 on ADC, analog 12
PC2 ADC1_6V6 ADC1 SCALE(2)
# pin2 on ADC, analog 13
PC3 ADC1_3V3 ADC1 SCALE(1)

# SPI1 - ICM45686
PG11 SPI1_SCK SPI1
PB5 SPI1_MOSI SPI1
PG9 SPI1_MISO SPI1
PI9 IMU1_CS CS
PF2 IMU1_DRDY INPUT

# SPI5 - FRAM
PF7  SPI5_SCK  SPI5
PH7  SPI5_MISO SPI5
PF11 SPI5_MOSI SPI5
PG7  FRAM_CS CS

# PWM output pins, BIDIR on alternating channels per timer for bi-directional dshot
PH10 TIM5_CH1 TIM5 PWM(1) GPIO(50) BIDIR
PH11 TIM5_CH2 TIM5 PWM(2) GPIO(51)
PH12 TIM5_CH3 TIM5 PWM(3) GPIO(52) BIDIR
PI0  TIM5_CH4 TIM5 PWM(4) GPIO(53)

PI5 TIM8_CH1 TIM8 PWM(5) GPIO(54) BIDIR
PI6 TIM8_CH2 TIM8 PWM(6) GPIO(55)
PI7 TIM8_CH3 TIM8 PWM(7) GPIO(56) BIDIR
PI2 TIM8_CH4 TIM8 PWM(8) GPIO(57)

PD12 TIM4_CH1 TIM4 PWM(9) GPIO(58) NODMA
PD13 TIM4_CH2 TIM4 PWM(10) GPIO(59) NODMA
PD14 TIM4_CH3 TIM4 PWM(11) GPIO(60) NODMA
PD15 TIM4_CH4 TIM4 PWM(12) GPIO(61) NODMA

# CAN bus
PD0  CAN1_RX CAN1
PD1  CAN1_TX CAN1

# I2C buses

# I2C1, GPS+MAG
PB9 I2C1_SDA I2C1
PB8 I2C1_SCL I2C1

# I2C2, GPS2+MAG
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2

# I2C3, external
PA8 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3

# I2C4 internal
PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4

# order of I2C buses
I2C_ORDER I2C4 I2C1 I2C2 I2C3
define HAL_I2C_INTERNAL_MASK 1

# power enable pins
PC13 VDD_3V3_SD_CARD_EN OUTPUT HIGH
PI11 VDD_3V3_SENSORS1_EN OUTPUT HIGH

# start peripheral power on
PG4  nVDD_5V_PERIPH_EN  OUTPUT LOW

# power sensing
PE15 VDD_5V_PERIPH_nOC INPUT PULLUP

PG1 VDD_BRICK_nVALID INPUT PULLUP

# microSD support
PD6  SDMMC2_CK SDMMC2
PD7  SDMMC2_CMD SDMMC2
PB14 SDMMC2_D0 SDMMC2
PB15 SDMMC2_D1 SDMMC2
PB3 SDMMC2_D2 SDMMC2
PB4  SDMMC2_D3 SDMMC2
define FATFS_HAL_DEVICE SDCD2

# safety
PD10 LED_SAFETY OUTPUT
PF5 SAFETY_IN INPUT PULLDOWN

# LEDs
PE3 LED_RED OUTPUT OPENDRAIN GPIO(90) HIGH
PE4 LED_GREEN OUTPUT OPENDRAIN GPIO(91) HIGH
PE5 LED_BLUE OUTPUT OPENDRAIN GPIO(92) HIGH

# setup for "pixracer" RGB LEDs
define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 90
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 91
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 92

define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# ID pins
PG0 HW_VER_REV_DRIVE OUTPUT LOW
PH3 HW_VER_SENS ADC3 SCALE(1)
PH4 HW_REV_SENS ADC3 SCALE(1)

# PWM output for buzzer
PF9 TIM14_CH1 TIM14 GPIO(77) ALARM

# RC input - PPM
PH6 TIM12_CH1 TIM12 RCININT PULLDOWN LOW

# builtin barometers
BARO BMP581 I2C:0:0x46

# GPS connector barometers
BARO BMP581 I2C:1:0x46
BARO BMP581 I2C:2:0x46

# compass
define AP_COMPASS_PROBING_ENABLED 1

# builtin compass
COMPASS IST8310 I2C:0:0x0E false ROTATION_YAW_180

# external baro and compass on I2C3
# enable as required
# BARO LPS2XH I2C:3:0x5D
# BARO BMP581 I2C:3:0x46
# BARO DPS310 I2C:3:0x77
# BARO MS5611 I2C:3:0x76
# COMPASS RM3100 I2C:3:0x20 true ROTATION_NONE
# COMPASS IST8310 I2C:3:0x0E true ROTATION_NONE
# COMPASS IIS2MDC I2C:3:0x1E true ROTATION_NONE
# COMPASS MMC5XX3  I2C:3:0x30 true ROTATION_NONE

# IMU device for YARIV6S
SPIDEV icm45686-1 SPI1 DEVID1 IMU1_CS MODE3 2*MHZ 8*MHZ

SPIDEV ramtron   SPI5 DEVID1  FRAM_CS     MODE3  8*MHZ  8*MHZ

# YARIV6S IMUs
IMU Invensensev3 SPI:icm45686-1 ROTATION_YAW_90

define HAL_DEFAULT_INS_FAST_SAMPLE 1

# enable RAMTRON parameter storage
define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

# INA2XX battery monitor
define HAL_BATTMON_INA2XX_BUS 1
define HAL_BATTMON_INA2XX_ADDR 0
define HAL_BATT_MONITOR_DEFAULT 21

# allow to have have a dedicated safety switch pin
define HAL_HAVE_SAFETY_SWITCH 1

DMA_PRIORITY TIM5* TIM4* SPI1* SPI2* SPI3* SDMMC* USART6* ADC* UART* USART*

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

# enable DFU reboot for installing bootloader
# note that if firmware is build with --secure-bl then DFU is
# disabled
ENABLE_DFU_BOOT 1

# build ABIN for flash-from-bootloader support:
env BUILD_ABIN True
