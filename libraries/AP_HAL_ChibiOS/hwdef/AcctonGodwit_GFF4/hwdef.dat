# hw definition file for processing by chibios_hwdef.py
# for Accton Godwit GFF4 (FCS220-1225-TW5_R0C)

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_Accton_Godwit_GFF4

# crystal frequency, setup to use external 8MHz oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# bootloader takes first 48KB
FLASH_RESERVE_START_KB 48

define STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 16384

# ChibiOS system timer
STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# LEDs - active low (anode to 3V3 through series resistor)
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PB3 LED0 OUTPUT HIGH GPIO(90) # Blue LED (active low)
PC4 LED1 OUTPUT HIGH GPIO(91) # Green LED (active low)
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91

# Beeper - PB15 drives NPN (MMBT3904) base through resistor, active high
PB15 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80
define HAL_BUZZER_ON 1

# 9V BEC enable (VTX power switch, HIGH: on, LOW: off)
# PB2 drives TPS62933 EN pin; pulled down by 10k for BOOT1
PB2 PINIO1 OUTPUT GPIO(81) HIGH
define RELAY1_PIN_DEFAULT 81
define RELAY1_DEFAULT 1

# PB14 is wired to ICM-42688-P CLKIN pin. Left as output low GPIO.
PB14 IMU_CLKIN OUTPUT LOW GPIO(88)

# SERIAL ports
# SERIAL0 = USB (OTG1)
# SERIAL1 = USART1  (ESC Telemetry from Main ESC connector J5)
# SERIAL2 = USART2 (GPS connector J4)
# SERIAL3 = USART3 (DJI O3 / Telemetry connector J5)
# SERIAL4 = UART4  (ELRS / Telemetry connector J9)
# SERIAL5 = UART5 (RC input connector / SBUS)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5

# USART1 (ESC Telemetry)
PA9  USART1_TX USART1 NODMA
PA10 USART1_RX USART1 NODMA
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_ESCTelemetry

# USART2 (GPS)
PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2 NODMA
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS

# USART3 (DJI O3 / Telemetry)
PB10 USART3_TX USART3 NODMA
PB11 USART3_RX USART3 NODMA
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_DJI_FPV

# UART4 (ELRS / Telemetry)
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_CRSF
define DEFAULT_SERIAL4_BAUD 115

# UART5 (RC input / SBUS)
# PD2 connects to hardware inverter (Q1 MMBT3904) for SBUS;
PD2  UART5_RX UART5 NODMA
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_RCIN

define AP_RCPROTOCOL_MAVLINK_RADIO_ENABLED 1
define HAL_CRSF_TELEM_ENABLED 1

# I2C bus (Baro, Compass, and external connector J10)
I2C_ORDER I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
define HAL_I2C_INTERNAL_MASK 0

# CAN bus (TLE9251VLE transceiver to connector J1)
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1
CAN_ORDER 1
define DRONECAN_NODE_POOL_SIZE 1024

# PWM outputs
# Motors 1-4 on TIM8 (Main ESC connector J3)
PC6 TIM8_CH1 TIM8 PWM(1) GPIO(50)
PC7 TIM8_CH2 TIM8 PWM(2) GPIO(51)
PC8 TIM8_CH3 TIM8 PWM(3) GPIO(52)
PC9 TIM8_CH4 TIM8 PWM(4) GPIO(53)

# Motors 5-8 on TIM3 (Ext ESC connector J8)
PB4 TIM3_CH1 TIM3 PWM(5) GPIO(54)
PB5 TIM3_CH2 TIM3 PWM(6) GPIO(55)
PB0 TIM3_CH3 TIM3 PWM(7) GPIO(56)
PB1 TIM3_CH4 TIM3 PWM(8) GPIO(57)

# NeoPixel / LED strip / Aux PWM on TIM1 (connector J8 pin 10)
PA8 TIM1_CH1 TIM1 PWM(9) GPIO(58)
define DEFAULT_NTF_LED_TYPES 257

# Motor order implies Betaflight/X for standard ESCs
define HAL_FRAME_TYPE_DEFAULT 12

# SPI devices

# SPI1: IMU (ICM-42688-P)
PA5  SPI1_SCK  SPI1
PA6  SPI1_MISO SPI1
PA7  SPI1_MOSI SPI1
PA4  GYRO1_CS  CS
PC15 ICM_INT   INPUT

SPIDEV imu1 SPI1 DEVID1 GYRO1_CS MODE3 1*MHZ 8*MHZ
IMU Invensensev3 SPI:imu1 ROTATION_ROLL_180
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# SPI2: OSD (AT7456E)
PB13 SPI2_SCK  SPI2
PC2  SPI2_MISO SPI2
PC3  SPI2_MOSI SPI2
PB12 OSD1_CS   CS

SPIDEV osd SPI2 DEVID1 OSD1_CS MODE0 10*MHZ 10*MHZ
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font0.bin

# SPI3: Dataflash (Macronix MX35LF2GE4AD via AP_Logger_W25NXX)
PC10 SPI3_SCK  SPI3
PC11 SPI3_MISO SPI3
PC12 SPI3_MOSI SPI3
PA15 FLASH1_CS CS

SPIDEV dataflash SPI3 DEVID1 FLASH1_CS MODE3 32*MHZ 32*MHZ
define HAL_LOGGING_DATAFLASH_ENABLED 1
define HAL_LOGGING_FLASH_W25NXX_ENABLED 1
define HAL_LOGGING_FLASH_W25NXX_MX35_ENABLED 1
define HAL_LOGGING_DATAFLASH_DRIVER AP_Logger_W25NXX

# Barometer (DPS368, handled by DPS310 driver on I2C1, addr 0x77)
BARO DPS310 I2C:0:0x77

# Compass (IST8310 on I2C1, addr 0x0C, and probe external compasses)
define AP_COMPASS_PROBING_ENABLED 1
define AP_COMPASS_IST8310_INTERNAL_BUS_PROBING_ENABLED 1
COMPASS IST8310 I2C:0:0x0C false ROTATION_YAW_270
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# ADC inputs
# Battery voltage: R44 100k / R46 10k divider -> ratio 11.0
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_VOLT_SCALE 11.0

# Battery current: from external ESC current sensor on J3 pin 7
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 11
define HAL_BATT_CURR_SCALE 40.0

define HAL_BATT_MONITOR_DEFAULT 4

# DMA assignments
DMA_NOSHARE TIM8_UP SPI1*
DMA_PRIORITY ADC1 TIM8* SPI1* TIM3* SPI2* SPI3*

# Flash size optimization for 1MB STM32F405
include ../include/minimize_fpv_osd.inc
