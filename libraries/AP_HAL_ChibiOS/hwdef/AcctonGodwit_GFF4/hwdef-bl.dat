# hw definition file for processing by chibios_hwdef.py
# bootloader for Accton Godwit GFF4 (FCS220-1225-TW5_R0C)

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_Accton_Godwit_GFF4

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
FLASH_BOOTLOADER_LOAD_KB 48

# order of UARTs (and USB)
SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Keep the 9V VTX rail disabled during bootloader and DFU operation.
PB2 PINIO1 OUTPUT LOW

# Chip select pins
PA15 FLASH1_CS CS
PB12 OSD1_CS CS
PA4 GYRO1_CS CS

# Blue LED on PB3 (active low)
PB3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0
