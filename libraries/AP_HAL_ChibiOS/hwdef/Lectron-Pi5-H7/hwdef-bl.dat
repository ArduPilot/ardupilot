# MCU class and crystal frequency
MCU STM32H7xx STM32H753xx
OSCILLATOR_HZ 16000000

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_LECTRON_Pi5_H7

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# Use TIM2 for ChibiOS system tick (matches FMU hwdef; H7 default is TIM5)
STM32_ST_USE_TIMER 2
DEFAULTGPIO OUTPUT LOW PULLDOWN

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART3

# USB - USB-C connector
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9  VBUS INPUT OPENDRAIN

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# debug uart
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# LEDs
PE3 LED_ACTIVITY OUTPUT OPENDRAIN HIGH # red
PE5 LED_BOOTLOADER OUTPUT OPENDRAIN HIGH # blue
define HAL_LED_ON 0

# CS pins
PI9  SP1_CS1 CS  # ICM-42670-P
PH5  SP2_CS1 CS  # ICM-42670-P
PI4  SP3_CS1 CS  # BMI270
PG7  SP5_CS1 CS  # FRAM
PI10 SP6_CS1 CS  # External
PA15 SP6_CS2 CS  # External

# start peripheral power on
PG4  nVDD_5V_PERIPH_EN  OUTPUT LOW

DMA_PRIORITY USART* UART*

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384
