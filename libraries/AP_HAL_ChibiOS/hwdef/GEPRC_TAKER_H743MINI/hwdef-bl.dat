# Experimental bootloader hwdef for GEPRC TAKER H743MINI.
# UART and chip-select pins cross-checked against Betaflight target.
# Verify oscillator, board ID, and flash layout against the actual PCB.

MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_GEPRC_TAKER_H743MINI
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048

# Bootloader starts at flash base; application load offset must match hwdef.dat.
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 384

SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 UART7 UART8

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# UART pins
PA9  USART1_TX USART1
PA10 USART1_RX USART1
PD5  USART2_TX USART2
PD6  USART2_RX USART2
PD8  USART3_TX USART3
PD9  USART3_RX USART3
PA0  UART4_TX UART4
PA1  UART4_RX UART4
PB5  UART5_RX UART5
PE8  UART7_TX UART7
PE7  UART7_RX UART7
PE1  UART8_TX UART8
PE0  UART8_RX UART8

# Keep attached SPI chip selects inactive during bootloader operation.
PB12 ICM42688P_CS CS
PA15 FLASH_CS CS
PE4 MAX7456_CS CS

# Status LED and active-low buzzer
PB7 LED_BOOTLOADER OUTPUT LOW
PD2 BUZZER OUTPUT LOW PULLDOWN
define HAL_LED_ON 0
