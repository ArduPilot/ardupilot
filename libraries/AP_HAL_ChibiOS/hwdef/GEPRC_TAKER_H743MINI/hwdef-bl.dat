# hw definition file for processing by chibios_hwdef.py
# for GEPRC TAKER H743MINI bootloader

MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_GEPRC_TAKER_H743MINI
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
FLASH_BOOTLOADER_LOAD_KB 384

SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# motors for esc init
PC6  PWMOUT1 OUTPUT LOW
PC7  PWMOUT2 OUTPUT LOW
PC8  PWMOUT3 OUTPUT LOW
PC9  PWMOUT4 OUTPUT LOW
PE9  PWMOUT5 OUTPUT LOW
PE11 PWMOUT6 OUTPUT LOW
PE13 PWMOUT7 OUTPUT LOW
PE14 PWMOUT8 OUTPUT LOW

# keep PINIO outputs (incl. 12V BEC) at their main firmware default
PC5 PINIO1 OUTPUT HIGH
PD3 PINIO2 OUTPUT HIGH

# Add CS pins to ensure they are high in bootloader
PB12 ICM42688P_CS CS
PA15 FLASH_CS CS
PE4 MAX7456_CS CS

PB7 LED_BOOTLOADER OUTPUT LOW
PD2 BUZZER OUTPUT LOW PULLDOWN
define HAL_LED_ON 0
