# One bootloader for F100 and F103 IOMCUs, independent of crystal and DShot.
# Use the smaller F100 RAM layout; the bootloader runs from HSI at 24 MHz.
MCU STM32F100 STM32F100xB

# The F1 IOMCU firmware ABI reserves exactly 4 KiB for the bootloader.
env IOMCU_BOOTLOADER 1
define AP_IOMCU_BOOTLOADER 1
APJ_BOARD_ID TARGET_HW_PX4_PIO_V1
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 4
FLASH_SIZE_KB 64
OSCILLATOR_HZ 24000000
MCU_CLOCKRATE_MHZ 24

SERIAL_ORDER
define HAL_USE_SERIAL FALSE
define AP_FASTBOOT_ENABLED 0
define __FPU_PRESENT 0
define CH_CFG_ST_FREQUENCY 1000
define CH_CFG_ST_TIMEDELTA 0
define CH_DBG_ENABLE_STACK_CHECK FALSE
define CH_CFG_NO_IDLE_THREAD TRUE
define CH_CFG_USE_HEAP FALSE
define CH_CFG_USE_MEMCORE FALSE
define CH_CFG_USE_DYNAMIC FALSE
define CH_CFG_USE_REGISTRY FALSE
define CH_CFG_USE_TM FALSE
define CH_CFG_USE_WAITEXIT FALSE
define CH_CFG_USE_EVENTS FALSE
define CH_CFG_USE_EVENTS_TIMEOUT FALSE
define DMA_RESERVE_SIZE 0
MAIN_STACK 0x100
PROCESS_STACK 0x300

PA2 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2
PB5 SAFETY_INPUT INPUT FLOATING
PB15 LED_BOOTLOADER OUTPUT LOW
