include ../VM-L431/hwdef.inc

undef APJ_BOARD_ID
APJ_BOARD_ID AP_HW_VIMDRONES_ELRS_RX_NANO

define CAN_APP_NODE_NAME "com.vimdrones.elrs_rx_nano"

# Allow for MAVLink tunnel traffic alongside RCInput transfers.
undef HAL_CAN_POOL_SIZE
define HAL_CAN_POOL_SIZE 8000

SERIAL_ORDER EMPTY USART2 VUART1

define AP_UART_MONITOR_ENABLED 1
define HAL_MAVLINK_BINDINGS_ENABLED 1
define AP_RADIO_SX1280_UART 1

STDOUT_BAUDRATE 57600
STDOUT_SERIAL SD2

PA2 USART2_TX USART2
PA3 USART2_RX USART2

define HAL_USE_ADC FALSE

define AP_PERIPH_RCIN_ENABLED 0
define AP_PERIPH_MODULE_RC_ENABLED 1

# SPI1 for SX1280
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 SX1280_CS CS
PA8 SX1280_RESET OUTPUT HIGH GPIO(70)
PB1 SX1280_BUSY INPUT GPIO(71)
PB0 SX1280_DIO1 INPUT GPIO(72)

define HAL_SX1280_RESET_PIN 70
define HAL_SX1280_BUSY_PIN 71
define HAL_SX1280_DIO1_PIN 72

SPIDEV sx1280 SPI1 DEVID1 SX1280_CS MODE0 10*MHZ 10*MHZ


PA9 SX1280_BUTTON INPUT PULLUP GPIO(73)

define HAL_SX1280_BUTTON_PIN 73
define HAL_SX1280_BUTTON_ACTIVE_HIGH 0

PA10 SX1280_LED OUTPUT HIGH GPIO(74)

define HAL_SX1280_LED_PIN 74
define HAL_SX1280_LED_ACTIVE_HIGH 0

# Native Rust receiver module (build the applet before configuring firmware).
define AP_MODULE_ENABLED 1
define AP_SCRIPTING_ENABLED 1
define AP_SCRIPTING_LUA_ENABLED 0
define AP_PARAM_DYNAMIC_ENABLED 1
define HAL_GCS_ENABLED 0
define AP_FILESYSTEM_ROMFS_ENABLED 1
define AP_BOOTLOADER_FLASHING_ENABLED 0
undef ROMFS_UNCOMPRESSED
ROMFS modules/elrs_full.apmod build/modules/l431/elrs_full.apmod
define AP_MODULE_SX1280_ENABLED 1

# Short SX1280 transfers avoid DMA scheduling overhead on this test target.
define HAL_SPI_USE_POLLED 1
