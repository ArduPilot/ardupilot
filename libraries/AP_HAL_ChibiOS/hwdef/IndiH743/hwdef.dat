# hw definition file for processing by chibios_hwdef.py
# for IndiH743

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_INDIH743

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# CAN bus
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# default to all pins low to avoid ESD issues
DEFAULTGPIO OUTPUT LOW PULLDOWN

# order of UARTs (and USB). OTG2 is a second USB CDC endpoint (SERIAL8).
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART7 UART8 USART6 OTG2

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PE2  VBUS INPUT

# GPS1
PE0 UART8_RX UART8
PE1 UART8_TX UART8
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_GPS

# TELEM1
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# TELEM2
PD6 USART2_RX USART2
PD5 USART2_TX USART2

# RC input
PB9 UART4_TX UART4
PB8 UART4_RX UART4
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_RCIN

# Analog VTX (IRC Tramp on TX) / Digital VTX (MSP on TX+RX); only TX is shared
PD8 USART3_TX USART3
PD9 USART3_RX USART3
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_Tramp
define DEFAULT_SERIAL3_OPTIONS 4

# Digital VTX SBUS / RC (USART6 RX on DV connector)
# Default RCIN remains UART4 (SERIAL4). For DJI / HD VTX SBUS set
# SERIAL7_PROTOCOL=23 and SERIAL4_PROTOCOL=-1, then reboot.
PC7 USART6_RX USART6 NODMA

# ESC telemetry
PE8 UART7_TX UART7
PE7 UART7_RX UART7
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_ESCTelemetry

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# two I2C buses
I2C_ORDER I2C1 I2C2

# I2C1 - external
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C2 - external + onboard baro
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# PWM outputs
PB0  TIM3_CH3 TIM3 PWM(1) GPIO(50) BIDIR
PB1  TIM3_CH4 TIM3 PWM(2) GPIO(51)
PA0  TIM5_CH1 TIM5 PWM(3) GPIO(52) BIDIR
PA1  TIM5_CH2 TIM5 PWM(4) GPIO(53)
PA2  TIM5_CH3 TIM5 PWM(5) GPIO(54) BIDIR
PA3  TIM5_CH4 TIM5 PWM(6) GPIO(55)
PD12 TIM4_CH1 TIM4 PWM(7) GPIO(56) BIDIR
PD13 TIM4_CH2 TIM4 PWM(8) GPIO(57)
PD14 TIM4_CH3 TIM4 PWM(9) GPIO(58)
PD15 TIM4_CH4 TIM4 PWM(10) GPIO(59)
PA8  TIM1_CH1 TIM1 PWM(11) GPIO(62)
# NeoPixel on PWM11 (SERVO11_FUNCTION 120); bit0 BuiltIn + bit8 NeoPixel
define DEFAULT_NTF_LED_TYPES 257

# buzzer
PA15 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80

# LEDs 
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE3 LED0 OUTPUT HIGH GPIO(90)
PE4 LED1 OUTPUT HIGH GPIO(91)
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91

# battery monitors
# BATT / BATT2 share voltage on PC0 (ADC1_IN10); ESC1/ESC2 current on PC1 / PA7
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
PA7 BATT2_CURRENT_SENS ADC1 SCALE(1)

# Voltage: calibrated BATT_VOLT_MULT 10.969
# Current: 0.25mOhm shunt + INA199A1 (gain 50) => 1/(0.00025*50) = 80 A/V
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 10.969
define HAL_BATT_CURR_SCALE 80.0

define HAL_BATT2_MONITOR_DEFAULT 4
define HAL_BATT2_VOLT_PIN 10
define HAL_BATT2_CURR_PIN 7
define HAL_BATT2_VOLT_SCALE 10.969
define HAL_BATT2_CURR_SCALE 80.0

# no onboard compass; probe I2C for external modules
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0

# microSD
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
define FATFS_HAL_DEVICE SDCD1

# SPI1 - BMI088
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PC14 BMI088_1_G_CS CS
PC15 BMI088_1_A_CS CS

# SPI2 - OSD
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PB12 AT7456E_CS CS

# SPI3 - external pads (CS on PD4)
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3
PD4 EXT_CS1 CS

# SPI4 - ICM42688-P or ICM45686 (same footprint / CS)
PE14 SPI4_MOSI SPI4
PE12 SPI4_SCK  SPI4
PE13 SPI4_MISO SPI4
PE11 ICM42688_CS CS
PE15 ICM42688_DRDY INPUT

# barometer
BARO DPS310 I2C:1:0x76

# SPI devices
SPIDEV imu0_a    SPI1 DEVID1 BMI088_1_A_CS MODE3 10*MHZ 10*MHZ
SPIDEV imu0_g    SPI1 DEVID2 BMI088_1_G_CS MODE3 10*MHZ 10*MHZ
# Invensensev3 probes WHOAMI for ICM-42688-P or ICM-45686 on this CS
SPIDEV icm42688  SPI4 DEVID1 ICM42688_CS   MODE3  2*MHZ  8*MHZ
SPIDEV osd       SPI2 DEVID5 AT7456E_CS    MODE0 10*MHZ 10*MHZ
SPIDEV pixartflow SPI3 DEVID1 EXT_CS1      MODE3  2*MHZ  2*MHZ

DMA_NOSHARE SPI1* SPI4*

# IMUs
IMU BMI088 SPI:imu0_a SPI:imu0_g ROTATION_NONE
IMU Invensensev3 SPI:icm42688 ROTATION_PITCH_180
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# FAT filesystem (microSD via SDMMC)
define HAL_OS_FATFS_IO 1

# OSD
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font0.bin
