# GPS on USART3 = SERIAL3
SERIAL3_BAUD     115

# VTX on USART6 = SERIAL6 (protocol comes from hwdef)
SERIAL6_OPTIONS  132 # half-duplex + TX pull-up for single-wire Tramp

# RX on USART7 = SERIAL7 (protocol comes from hwdef)
RSSI_TYPE        3
RC_OPTIONS       15136

# WS2812 LED string on PWM11 / PA8 (TIM1)
SERVO11_FUNCTION 120    # 120 = NeoPixel
NTF_LED_TYPES    257    # 257 = Built-in LED (bit 0) + NeoPixel (bit 8)

# Video transmitter
VTX_ENABLE 1
VTX_BAND 4
VTX_POWER 25
VTX_MAX_POWER 1000

# VOUT1 video power switch on PC12 / GPIO81 (pin set in hwdef)
RELAY2_FUNCTION  1

# Video input select on PC13 / GPIO83, ground station vs ELRS (pin set in hwdef)
RELAY1_FUNCTION  1
RC7_OPTION       28
