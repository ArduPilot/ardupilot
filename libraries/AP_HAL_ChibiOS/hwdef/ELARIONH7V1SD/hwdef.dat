# hw definition file for processing by chibios_pins.py
# for Elarion H743 V1, microSD logging variant
#
# Identical to ELARIONH7V1 apart from what sits on SPI3: this variant has a
# microSD card there instead of the GD25Q128 JEDEC flash chip. Everything
# else - pins, sensors, DMA, motors, defaults - comes from the base hwdef.

include ../ELARIONH7V1/hwdef.dat

# Distinct board ID: the two variants have different devices on PC11 and
# different logging backends, so their firmwares must not be interchangeable.
APJ_BOARD_ID AP_HW_ELARIONH7V1SD

# SPI3 carries a microSD card instead of the JEDEC flash chip.
# undef PC11 releases the pin (and its FLASH_CS label) for redefinition;
# undef dataflash drops the base's SPIDEV entry.
undef PC11
undef dataflash
PC11 SDCARD_CS CS
SPIDEV sdcard SPI3 DEVID1 SDCARD_CS   MODE0 400*KHZ 25*MHZ

# SD card logging instead of the JEDEC flash backend
undef HAL_LOGGING_DATAFLASH_ENABLED
undef HAL_LOGGING_FLASH_JEDEC_ENABLED
undef HAL_LOGGING_BACKENDS_DEFAULT
define HAL_LOGGING_BACKENDS_DEFAULT 1
define HAL_OS_FATFS_IO 1
define HAL_SDCARD_SPI_CS_PIN SDCARD_CS
define HAL_USE_SDC FALSE
