# AD-TALON V6 CORE (Board ID 6500) | BUILD CANDIDATE (NOT FLIGHT QUALIFIED)
# MCU: STM32H753IIK6 (STM32H743xx alias) | ArduPilot PR #34979 (Pending)
MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 16000000
STM32_ST_USE_TIMER 2
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
APJ_BOARD_ID AP_HW_AD_TALON_V6
USB_STRING_MANUFACTURER "ADSYSTEM"
USB_STRING_PRODUCT "AD-TALON V6"

# Serial mapping: 0=USB, 1=TELEM1, 2=TELEM2, 3=GPS1, 4=GPS2,
# 5=TELEM3, 6=UART4, 7=DEBUG. USART6 is reserved to BASE IOMCU.
SERIAL_ORDER OTG1 UART7 UART5 USART1 UART8 USART2 UART4 USART3
PA9 VBUS INPUT
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PE8 UART7_TX UART7
PF6 UART7_RX UART7
PF8 UART7_RTS UART7
PE10 UART7_CTS UART7
PC12 UART5_TX UART5
PD2 UART5_RX UART5
PC8 UART5_RTS UART5
PC9 UART5_CTS UART5
PB6 USART1_TX USART1
PB7 USART1_RX USART1
PE1 UART8_TX UART8
PE0 UART8_RX UART8
PD5 USART2_TX USART2
PA3 USART2_RX USART2
PD4 USART2_RTS USART2
PD3 USART2_CTS USART2
PH13 UART4_TX UART4
PH14 UART4_RX UART4
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# Dedicated ArduPilot CORE <-> BASE UART, preserving known-working Stage 6.
PC6 USART6_TX USART6
PC7 USART6_RX USART6
IOMCU_UART USART6
DMA_NOSHARE USART6_TX USART6_RX
DMA_PRIORITY SDMMC* USART6* ADC* UART* USART* SPI* TIM*
ROMFS io_firmware.bin Tools/IO_Firmware/iofirmware_adtalon_12mhz.bin
# FMU bootloader flashing disabled; IOMCU auto-update is controlled by BRD_IO_ENABLE.
define AP_BOOTLOADER_FLASHING_ENABLED 0
define HAL_HAVE_SAFETY_SWITCH 1

# CORE status LED - existing working active-low open-drain outputs.
PE3 LED_RED OUTPUT OPENDRAIN GPIO(90) HIGH
PE4 LED_GREEN OUTPUT OPENDRAIN GPIO(91) HIGH
PE5 LED_BLUE OUTPUT OPENDRAIN GPIO(92) HIGH
# CORE RGB Status LED - Active Low, Open Drain
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1
define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 90
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 91
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 92

# Regulated sensor rails; all four enabled when firmware starts.
PI11 VDD_3V3_SENSORS1_EN OUTPUT HIGH
PF4 VDD_3V3_SENSORS2_EN OUTPUT HIGH
PE7 VDD_3V3_SENSORS3_EN OUTPUT HIGH
PG8 VDD_3V3_SENSORS4_EN OUTPUT HIGH
PC13 VDD_3V3_SD_CARD_EN OUTPUT HIGH

# Peripheral 5V Power Enable (Active-Low)
PG4 nVDD_5V_PERIPH_EN OUTPUT HIGH GPIO(81)
# High-Power 5V Enable (Active-Low)
PG10 nVDD_5V_HIPOWER_EN OUTPUT HIGH GPIO(82)
PH2 SPEKTRUM_PWR OUTPUT HIGH GPIO(73)
define HAL_GPIO_SPEKTRUM_PWR 73
define HAL_SPEKTRUM_PWR_ENABLED 1
# Peripheral 5V FAULT input
PE15 VDD_5V_PERIPH_nOC INPUT PULLUP GPIO(83)
# High-Power 5V FAULT input
PF13 VDD_5V_HIPOWER_nOC INPUT PULLUP GPIO(84)
PG1 VDD_BRICK_nVALID INPUT PULLUP
PG2 VDD_BRICK2_nVALID INPUT PULLUP
PG3 VDD_BRICK3_nVALID INPUT PULLUP
PE6 nARMED OUTPUT HIGH

# SPI1 ICM-20649, SPI2 ICM-42688-P, SPI3 BMI088 (dual CS).
PA5 SPI1_SCK SPI1
PG9 SPI1_MISO SPI1
PB5 SPI1_MOSI SPI1
PI9 ICM20649_CS CS
PF2 ICM20649_DRDY INPUT
PI1 SPI2_SCK SPI2
PI2 SPI2_MISO SPI2
PI3 SPI2_MOSI SPI2
PH5 ICM42688_CS CS
PA10 ICM42688_DRDY INPUT
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PB2 SPI3_MOSI SPI3
PI4 BMI088_A_CS CS
PI8 BMI088_G_CS CS
PI6 BMI088_A_DRDY INPUT
PI7 BMI088_G_DRDY INPUT
SPIDEV icm20649 SPI1 DEVID1 ICM20649_CS MODE3 2*MHZ 8*MHZ
SPIDEV icm42688 SPI2 DEVID1 ICM42688_CS MODE3 2*MHZ 8*MHZ
SPIDEV bmi088_a SPI3 DEVID1 BMI088_A_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_g SPI3 DEVID2 BMI088_G_CS MODE3 10*MHZ 10*MHZ
# AD-TALON V6 IMU orientation
# ICM-20649 - SPI1
IMU Invensensev2 SPI:icm20649 ROTATION_ROLL_180
# ICM-42688-P - SPI2
IMU Invensensev3 SPI:icm42688 ROTATION_ROLL_180_YAW_270
# BMI088 - SPI3
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_PITCH_180

# SPI5 non-volatile parameter FRAM: replaces Stage 6 EMPTY STORAGE.
PF7 SPI5_SCK SPI5
PH7 SPI5_MISO SPI5
PF11 SPI5_MOSI SPI5
PG7 FRAM_CS CS
SPIDEV ramtron SPI5 DEVID1 FRAM_CS MODE3 8*MHZ 8*MHZ
define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

# SPI6 physical interface (no external device driver yet).
PB3 SPI6_SCK SPI6
PA6 SPI6_MISO SPI6
PG14 SPI6_MOSI SPI6
PI10 EXT1_CS1 CS
PA15 EXT1_CS2 CS
PF10 nSPI6_RESET_EXTERNAL1 OUTPUT HIGH
PD11 EXT1_DRDY1 INPUT
PD12 EXT1_DRDY2 INPUT

# Internal I2C4 BARO+MAG+EEPROM, external buses I2C1/2/3.
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2
PA8 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3
PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4
PG5 ICP20100_DRDY INPUT
I2C_ORDER I2C4 I2C1 I2C2 I2C3
define HAL_I2C_INTERNAL_MASK 1
# ICP-20100 7-bit address. Driver type ICP201XX in ArduPilot.
# CORE ICP-20100 / AD0=LOW / I2C2
BARO ICP201XX I2C:2:0x63
# IMU ICP-20100 / AD0=HIGH / I2C4
BARO ICP201XX I2C:0:0x64
# Retain boot and MAVLink diagnostics even if barometer probe fails on bench.
define HAL_BARO_ALLOW_INIT_NO_BARO 1
define AP_COMPASS_PROBING_ENABLED 1
COMPASS RM3100 I2C:0:0x20 false ROTATION_NONE
# 24LC64 on I2C4 has no generic hwdef driver declaration; bus is ready.

# AD-TALON V6 RM3100 X-axis polarity correction
define AP_RM3100_REVERSAL_MASK 1

# 8 local CORE PWM outputs. BASE IOMCU owns outputs 1-8;
# these become ArduPilot SERVO outputs 9-16 (no motor connected for bring-up).
PI0 TIM5_CH4 TIM5 PWM(1) GPIO(50)
PH12 TIM5_CH3 TIM5 PWM(2) GPIO(51)
PH11 TIM5_CH2 TIM5 PWM(3) GPIO(52)
PH10 TIM5_CH1 TIM5 PWM(4) GPIO(53)
PD13 TIM4_CH2 TIM4 PWM(5) GPIO(54)
PD14 TIM4_CH3 TIM4 PWM(6) GPIO(55)
PH6 TIM12_CH1 TIM12 PWM(7) GPIO(56) NODMA
PH9 TIM12_CH2 TIM12 PWM(8) GPIO(57) NODMA

# CAN (DroneCAN transport configured at runtime via CAN_P*/CAN_D* params).
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PB12 CAN2_RX CAN2
PB13 CAN2_TX CAN2

# microSD on SDMMC2 (on-board SD regulator enabled above).
PD6 SDMMC2_CK SDMMC2
PD7 SDMMC2_CMD SDMMC2
PB14 SDMMC2_D0 SDMMC2
PB15 SDMMC2_D1 SDMMC2
PG11 SDMMC2_D2 SDMMC2
PB4 SDMMC2_D3 SDMMC2
define FATFS_HAL_DEVICE SDCD2
define HAL_OS_FATFS_IO 1

# Analog sensing. No battery scale is asserted for these rails.
PA0 SCALED1_V3V3 ADC1 SCALE(2)
PA4 SCALED2_V3V3 ADC1 SCALE(2)
PB0 SCALED3_V3V3 ADC1 SCALE(2)
PF12 SCALED4_V3V3 ADC1 SCALE(2)
PB1 VDD_5V_SENS ADC1 SCALE(2)
PC2 ADC1_6V6 ADC1 SCALE(2)
PC3 ADC1_3V3 ADC1 SCALE(1)


# AD-TALON V6 IMU Heater
# Heater MOSFET: Active-High
PB10 HEATER_EN OUTPUT LOW GPIO(80)

# ArduPilot standard IMU heater
define HAL_HEATER_GPIO_PIN 80
define HAL_HAVE_IMU_HEATER 1

# Temperature feedback: ICM-42688-P on IMU board
# Expected runtime instance: IMU1
define AP_HEATER_IMU_INSTANCE 1

# Default disabled for initial validation
define HAL_IMU_TEMP_DEFAULT -1

# Standard Pixhawk 6X heater PI settings
define HAL_IMUHEAT_P_DEFAULT 50
define HAL_IMUHEAT_I_DEFAULT 0.07

# Do not enable heater temperature arming check yet
define HAL_IMU_TEMP_MARGIN_LOW_DEFAULT 0

PG0 HW_VER_REV_DRIVE OUTPUT LOW
PE11 FMU_CAP1 INPUT GPIO(58)
PC0 NFC_GPIO INPUT GPIO(60)
PF9 TIM14_CH1 TIM14 GPIO(77) ALARM
PI5 TIM8_CH1 TIM8 RCININT PULLDOWN LOW
# SWD/FMU safety control pins PD10/PF5 remain BASE-owned during bring-up.
# Ethernet PHY/RMII: provision GPIO and MAC; requires network-service configuration.
PA1 ETH_RMII_REF_CLK ETH1
PA2 ETH_MDIO ETH1
PC1 ETH_MDC ETH1
PA7 ETH_RMII_CRS_DV ETH1
PC4 ETH_RMII_RXD0 ETH1
PC5 ETH_RMII_RXD1 ETH1
PB11 ETH_RMII_TX_EN ETH1
PG13 ETH_RMII_TXD0 ETH1
PG12 ETH_RMII_TXD1 ETH1
PG15 GPIO_ETH_ENABLE OUTPUT HIGH GPIO(113)
define HAL_GPIO_ETH_ENABLE 113
define BOARD_PHY_ID MII_LAN8742A_ID
define BOARD_PHY_RMII
