# AD-TALON V6 CORE bootloader definition (STM32H753IIK6)
# Board ID 6500 - registered in upstream ArduPilot.

MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 16000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128
APJ_BOARD_ID AP_HW_AD_TALON_V6

USB_STRING_MANUFACTURER "ADSYSTEM"
USB_STRING_PRODUCT "AD-TALON V6 BL"

# CORE USB FS, dedicated update path; no external UART enabled for bootloader.
SERIAL_ORDER OTG1
PA9 VBUS INPUT
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD recovery interface
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Existing Active-Low RGB LED hardware: red activity, blue bootloader.
PE3 LED_ACTIVITY OUTPUT OPENDRAIN HIGH
PE5 LED_BOOTLOADER OUTPUT OPENDRAIN HIGH
define HAL_LED_ON 0

# Enable peripheral power rails.
PG4 nVDD_5V_PERIPH_EN OUTPUT LOW
PG10 nVDD_5V_HIPOWER_EN OUTPUT LOW

# No persistent storage is used by the bootloader.
define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384
