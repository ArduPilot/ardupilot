# GPS on USART3 = SERIAL3. Protocol comes from the firmware default (GPS).
# Our module comes up at 115200; the firmware default is 230400.
SERIAL3_BAUD     115

# VTX on USART6 = SERIAL6, protocol set in hwdef (Tramp).
# 132 = HalfDuplex (bit 2) + TX_PullUp (bit 7). IRC Tramp is a single-wire
# bus that has to idle high. Baud is not set here: AP_Tramp always opens
# the port at 9600 itself.
SERIAL6_OPTIONS  132

# CRSF/ELRS receiver on UART7 = SERIAL7, protocol set in hwdef (RCIN).
# Baud is not set here either: AP_RCProtocol cycles its own baud table.
RSSI_TYPE        3      # 3 = RSSI from the RC protocol, not the analog RSSI pad
# 15136 = ArmingCheckThrottle(5) + CRSFCustomTelemetry(8)
#       + SuppressCRSFMessage(9) + UseCRSFLQAsRSSI(11)
#       + CRSFFlightModeDisarmStar(12) + ELRS420kbaud(13)
RC_OPTIONS       15136

# Analog OSD (MAX7456) is enabled in hwdef as OSD_TYPE 1.
# 5 = MSP DisplayPort, for HD goggles on any UART set to protocol 42.
OSD_TYPE2        5

# WS2812 LED string on PWM11 / PA8 (TIM1)
SERVO11_FUNCTION 120    # 120 = NeoPixel
NTF_LED_TYPES    257    # 257 = Built-in LED (bit 0) + NeoPixel (bit 8)

# Bidirectional DShot, matching the ESCs we ship. See ELARION_BDSHOT.md.
MOT_PWM_TYPE     6      # 6 = DShot600
SERVO_BLH_BDMASK 15     # bidir DShot on motors 1-4
SERVO_DSHOT_ESC  4      # 4 = BLHeli_S / Bluejay with Extended DShot Telemetry

# Video transmitter (IRC Tramp)
VTX_ENABLE       1      # required: AP_Tramp::init() gives up if the VTX is disabled
VTX_BAND         4      # 4 = RaceBand
VTX_POWER        25     # mW at boot
VTX_MAX_POWER    1000   # mW ceiling for the VTX power aux switch

# VOUT1 video power switch on PC12 / GPIO81 (pin set in hwdef)
RELAY2_FUNCTION  1      # 1 = generic relay
# Video input select on PC13 / GPIO83, ground station vs ELRS (pin set in hwdef)
RELAY1_FUNCTION  1
RC7_OPTION       28     # 28 = Relay1 on/off; this option only ever drives relay 1
