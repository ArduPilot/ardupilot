# hw definition file for processing by chibios_hwdef.py
# for the AeroStem H743 V1 bootloader (AeroStem Technology)
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_AeroStemH743V1

# USB identity (product string defaults to the board name)
USB_STRING_MANUFACTURER "AeroStem"

# crystal frequency
OSCILLATOR_HZ 8000000

# flash size
FLASH_SIZE_KB 2048

# bootloader is installed at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
FLASH_BOOTLOADER_LOAD_KB 128



# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# CS pins
PB12 AT7456E_CS CS
PA15 BMI270_CS  CS
PD5  GYRO_CS    CS
PD4  ACCEL_CS   CS

# LEDs
PE6 LED_ACTIVITY   OUTPUT LOW #green
PE4 LED_BOOTLOADER OUTPUT LOW #blue
define HAL_LED_ON 0
